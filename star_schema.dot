digraph star {
  graph [rankdir=LR, splines=true, overlap=false, nodesep=0.35, ranksep=1.2, bgcolor="white", label="CSC 307 Group 1 - School Performance Data Warehouse (Upper West, synthetic)\nConstellation schema: 3 fact tables share conformed dimensions", labelloc=t, fontsize=20, fontname="Helvetica-Bold"];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [color="#555555", arrowhead=crow, arrowtail=none];
  dim_date [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#9DC3E6" align="center"><b>dim_date</b></td></tr><tr><td align="left">PK date_key : integer</td></tr><tr><td align="left">full_date : date</td></tr><tr><td align="left">day_name : varchar(9)</td></tr><tr><td align="left">day_of_week : smallint</td></tr><tr><td align="left">day_of_month : smallint</td></tr><tr><td align="left">month_number : smallint</td></tr><tr><td align="left">month_name : varchar(9)</td></tr><tr><td align="left">quarter : smallint</td></tr><tr><td align="left">year : smallint</td></tr><tr><td align="left">is_weekend : boolean</td></tr><tr><td align="left">is_public_holiday : boolean</td></tr><tr><td align="left">holiday_name : varchar(40)</td></tr><tr><td align="left">season : varchar(5)</td></tr></table>>];
  dim_location [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#9DC3E6" align="center"><b>dim_location</b></td></tr><tr><td align="left">PK location_key : integer</td></tr><tr><td align="left">region : varchar(20)</td></tr><tr><td align="left">district_code : varchar(4)</td></tr><tr><td align="left">district : varchar(30)</td></tr><tr><td align="left">district_capital : varchar(20)</td></tr><tr><td align="left">town : varchar(30)</td></tr><tr><td align="left">urban_rural : varchar(5)</td></tr><tr><td align="left">electoral_area : varchar(40)</td></tr><tr><td align="left">latitude : decimal(8,5)</td></tr><tr><td align="left">longitude : decimal(8,5)</td></tr></table>>];
  dim_school [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#9DC3E6" align="center"><b>dim_school (SCD 2)</b></td></tr><tr><td align="left">PK school_key : integer</td></tr><tr><td align="left">emis_code : varchar(12)</td></tr><tr><td align="left">school_name : varchar(40)</td></tr><tr><td align="left">school_level : varchar(7)</td></tr><tr><td align="left">ownership : varchar(7)</td></tr><tr><td align="left">gender_type : varchar(5)</td></tr><tr><td align="left">boarding_status : varchar(13)</td></tr><tr><td align="left">free_shs_category : varchar(14)</td></tr><tr><td align="left">has_electricity : boolean</td></tr><tr><td align="left">has_potable_water : boolean</td></tr><tr><td align="left">has_girls_toilets : boolean</td></tr><tr><td align="left">has_ict_lab : boolean</td></tr><tr><td align="left">has_library : boolean</td></tr><tr><td align="left">num_classrooms : smallint</td></tr><tr><td align="left">distance_to_district_capital_km : decimal(5,1)</td></tr><tr><td align="left">effective_from : date</td></tr><tr><td align="left">effective_to : date</td></tr><tr><td align="left">is_current : boolean</td></tr><tr><td align="left">version_no : smallint</td></tr></table>>];
  dim_learner [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#9DC3E6" align="center"><b>dim_learner</b></td></tr><tr><td align="left">PK learner_key : integer</td></tr><tr><td align="left">learner_pseudo_id : varchar(12)</td></tr><tr><td align="left">sex : varchar(6)</td></tr><tr><td align="left">learner_level : varchar(3)</td></tr><tr><td align="left">age_at_entry : smallint</td></tr><tr><td align="left">disability_type : varchar(12)</td></tr><tr><td align="left">home_language : varchar(8)</td></tr><tr><td align="left">guardian_occupation : varchar(14)</td></tr><tr><td align="left">distance_home_to_school_km : decimal(4,1)</td></tr><tr><td align="left">free_shs_beneficiary : varchar(14)</td></tr><tr><td align="left">lives_with : varchar(8)</td></tr><tr><td align="left">shs_programme : varchar(20)</td></tr></table>>];
  dim_subject [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#9DC3E6" align="center"><b>dim_subject</b></td></tr><tr><td align="left">PK subject_key : integer</td></tr><tr><td align="left">subject_code : varchar(8)</td></tr><tr><td align="left">subject_name : varchar(30)</td></tr><tr><td align="left">exam_level : varchar(6)</td></tr><tr><td align="left">core_or_elective : varchar(8)</td></tr><tr><td align="left">stem_flag : boolean</td></tr></table>>];
  dim_examination [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#9DC3E6" align="center"><b>dim_examination</b></td></tr><tr><td align="left">PK exam_key : integer</td></tr><tr><td align="left">exam_type : varchar(8)</td></tr><tr><td align="left">exam_year : smallint</td></tr><tr><td align="left">sitting : varchar(8)</td></tr><tr><td align="left">examining_body : varchar(6)</td></tr><tr><td align="left">candidate_class : varchar(4)</td></tr><tr><td align="left">first_paper_date : date</td></tr></table>>];
  dim_teacher [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#9DC3E6" align="center"><b>dim_teacher</b></td></tr><tr><td align="left">PK teacher_key : integer</td></tr><tr><td align="left">staff_pseudo_id : varchar(10)</td></tr><tr><td align="left">sex : varchar(6)</td></tr><tr><td align="left">highest_qualification : varchar(40)</td></tr><tr><td align="left">is_trained : boolean</td></tr><tr><td align="left">ges_rank : varchar(30)</td></tr><tr><td align="left">subject_specialism : varchar(30)</td></tr><tr><td align="left">years_of_service : smallint</td></tr><tr><td align="left">teaches_in_home_district : boolean</td></tr><tr><td align="left">employment_type : varchar(20)</td></tr></table>>];
  dim_academic_term [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#9DC3E6" align="center"><b>dim_academic_term</b></td></tr><tr><td align="left">PK term_key : integer</td></tr><tr><td align="left">academic_year : varchar(9)</td></tr><tr><td align="left">term_number : smallint</td></tr><tr><td align="left">term_label : varchar(20)</td></tr><tr><td align="left">term_start_date : date</td></tr><tr><td align="left">term_end_date : date</td></tr></table>>];
  fact_exam_result [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#F4B183" align="center"><b>fact_exam_result  [MAIN FACT]</b></td></tr><tr><td align="left">PK exam_result_id : bigint</td></tr><tr><td align="left">FK learner_key : integer</td></tr><tr><td align="left">FK school_key : integer</td></tr><tr><td align="left">FK location_key : integer</td></tr><tr><td align="left">FK subject_key : integer</td></tr><tr><td align="left">FK exam_key : integer</td></tr><tr><td align="left">FK exam_date_key : integer</td></tr><tr><td align="left">FK teacher_key : integer</td></tr><tr><td align="left">candidate_index_no : varchar(24)</td></tr><tr><td align="left">raw_score : decimal(4,1)</td></tr><tr><td align="left">grade : varchar(3)</td></tr><tr><td align="left">grade_point : smallint</td></tr><tr><td align="left">is_passed : boolean</td></tr><tr><td align="left">is_absent : boolean</td></tr></table>>];
  fact_enrolment [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#F4B183" align="center"><b>fact_enrolment</b></td></tr><tr><td align="left">PK enrolment_id : bigint</td></tr><tr><td align="left">FK school_key : integer</td></tr><tr><td align="left">FK location_key : integer</td></tr><tr><td align="left">FK term_key : integer</td></tr><tr><td align="left">FK snapshot_date_key : integer</td></tr><tr><td align="left">class_name : varchar(4)</td></tr><tr><td align="left">enrolled_boys : integer</td></tr><tr><td align="left">enrolled_girls : integer</td></tr><tr><td align="left">pupils_with_disability : integer</td></tr><tr><td align="left">avg_daily_attendance : decimal(6,1)</td></tr><tr><td align="left">dropouts_boys : integer</td></tr><tr><td align="left">dropouts_girls : integer</td></tr><tr><td align="left">repeaters : integer</td></tr><tr><td align="left">transfers_in : integer</td></tr><tr><td align="left">transfers_out : integer</td></tr></table>>];
  fact_staffing [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#F4B183" align="center"><b>fact_staffing</b></td></tr><tr><td align="left">PK staffing_id : bigint</td></tr><tr><td align="left">FK school_key : integer</td></tr><tr><td align="left">FK location_key : integer</td></tr><tr><td align="left">FK term_key : integer</td></tr><tr><td align="left">FK snapshot_date_key : integer</td></tr><tr><td align="left">trained_teachers : smallint</td></tr><tr><td align="left">untrained_teachers : smallint</td></tr><tr><td align="left">female_teachers : smallint</td></tr><tr><td align="left">teacher_vacancies : smallint</td></tr><tr><td align="left">total_enrolment : integer</td></tr><tr><td align="left">pupil_teacher_ratio : decimal(5,1)</td></tr><tr><td align="left">pupil_trained_teacher_ratio : decimal(5,1)</td></tr></table>>];
  dim_learner -> fact_exam_result [taillabel="1", headlabel="*", fontsize=8];
  dim_school -> fact_exam_result [taillabel="1", headlabel="*", fontsize=8];
  dim_location -> fact_exam_result [taillabel="1", headlabel="*", fontsize=8];
  dim_subject -> fact_exam_result [taillabel="1", headlabel="*", fontsize=8];
  dim_examination -> fact_exam_result [taillabel="1", headlabel="*", fontsize=8];
  dim_date -> fact_exam_result [taillabel="1", headlabel="*", fontsize=8];
  dim_teacher -> fact_exam_result [taillabel="1", headlabel="*", fontsize=8];
  dim_school -> fact_enrolment [taillabel="1", headlabel="*", fontsize=8];
  dim_location -> fact_enrolment [taillabel="1", headlabel="*", fontsize=8];
  dim_academic_term -> fact_enrolment [taillabel="1", headlabel="*", fontsize=8];
  dim_date -> fact_enrolment [taillabel="1", headlabel="*", fontsize=8];
  dim_school -> fact_staffing [taillabel="1", headlabel="*", fontsize=8];
  dim_location -> fact_staffing [taillabel="1", headlabel="*", fontsize=8];
  dim_academic_term -> fact_staffing [taillabel="1", headlabel="*", fontsize=8];
  dim_date -> fact_staffing [taillabel="1", headlabel="*", fontsize=8];
}